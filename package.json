{
  "name": "the-cheese-vault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --config vite.config.mjs --configLoader native",
    "build": "vite build --config vite.config.mjs --configLoader native",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 5174 --strictPort --config vite.config.mjs --configLoader native",
    "test": "npm run test:core && npm run test:ui",
    "check:export": "node scripts/check-export.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "test:core": "node scripts/test-core.mjs",
    "test:ui": "vitest run --config vitest.config.mjs --configLoader native",
    "test:browser": "node scripts/browser.mjs",
    "test:browser:install": "node scripts/browser.mjs --install"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.3.6",
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.0",
    "wagmi": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.28.2",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  }
}
